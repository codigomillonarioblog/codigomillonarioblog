name: Generar Sitemap Automático

on:
  push:
    branches:
      - main  # O 'master' según tu rama principal

jobs:
  sitemap_job:
    runs-on: ubuntu-latest
    name: Generar Sitemap XML
    steps:
      - name: Checkout del código
        uses: actions/checkout@v4

      - name: Configurar Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Generar Sitemap con Python
        run: |
          python -c '
          import os
          import xml.etree.ElementTree as ET

          base_url = "https://codigomillonario.blog"
          urlset = ET.Element("urlset", xmlns="http://www.sitemaps.org/schemas/sitemap/0.9")

          ignore_dirs = {".git", ".github", "assets", "css", "js", "img", "images"}
          ignore_files = {"404.html"}

          for root, dirs, files in os.walk("."):
              dirs[:] = [d for d in dirs if d not in ignore_dirs]
              for file in files:
                  if file.endswith(".html"):
                      rel_path = os.path.relpath(os.path.join(root, file), ".")
                      if file in ignore_files and rel_path == file:
                          continue
                      
                      # Convertir ruta de archivo a URL limpia
                      if rel_path == "index.html":
                          url_path = ""
                      elif rel_path.endswith("/index.html"):
                          url_path = rel_path[:-10].replace(os.sep, "/") + "/"
                      else:
                          url_path = rel_path.replace(os.sep, "/")
                      
                      full_url = f"{base_url}/{url_path}" if url_path else f"{base_url}/"
                      
                      url_element = ET.Element("url")
                      loc = ET.SubElement(url_element, "loc")
                      loc.text = full_url
                      urlset.append(url_element)

          tree = ET.ElementTree(urlset)
          ET.indent(tree, space="  ")
          tree.write("sitemap.xml", encoding="utf-8", xml_declaration=True)
          '

      - name: Guardar Sitemap en el Repositorio
        uses: stefanzweifel/git-auto-commit-action@v5
        with:
          commit_message: "chore: actualización automática de sitemap.xml"
          file_pattern: "sitemap.xml"
